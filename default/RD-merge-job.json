      },
      "properties" : {
        "Script Engine" : "Groovy",
        "Script Body" : "import org.apache.nifi.processor.io.StreamCallback\nimport groovy.json.JsonSlurper\nimport groovy.json.JsonOutput\nimport java.nio.charset.StandardCharsets\nimport java.time.Instant\nimport java.time.ZoneId\nimport java.time.ZonedDateTime\nimport java.time.format.DateTimeFormatter\n\ndef flowFile = session.get()\nif (!flowFile) return\n\n// IST timezone\ndef istZone = ZoneId.of(\"Asia/Kolkata\")\n\n// Timestamp format\ndef formatter = DateTimeFormatter.ofPattern(\"yyyy-MM-dd HH:mm:ss\")\n\nflowFile = session.write(flowFile, { inputStream, outputStream ->\n\n    // Read input JSON\n    def jsonText = inputStream.getText(\"UTF-8\")\n    def data = new JsonSlurper().parseText(jsonText)\n\n    def transformed = []\n\n    // Current time (IST)\n    def now = ZonedDateTime.now(istZone)\n    def createdAtStr = now.format(formatter)\n    def updatedAtStr = createdAtStr\n\n    // Process records\n    data.each { record ->\n\n        // Timestamp\n        def timestampMs = (record.timestamp as BigDecimal).longValue()\n        def eventZdt = Instant.ofEpochMilli(timestampMs).atZone(istZone)\n\n        // 5-min bucket\n        def bucketMinute = (eventZdt.minute.intdiv(5)) * 5\n\n        def bucketStart = eventZdt\n                .withMinute(bucketMinute)\n                .withSecond(0)\n                .withNano(0)\n\n        def bucketEnd = bucketStart\n                .plusMinutes(4)\n                .plusSeconds(59)\n\n        def startTimeStr = bucketStart.format(formatter)\n        def endTimeStr   = bucketEnd.format(formatter)\n        def eventTimeStr = eventZdt.format(formatter)\n\n        // Process stats\n        record.stats.each { stat ->\n\n            transformed << [\n\n                // UPSERT keys\n                start_time              : startTimeStr,\n                queue_id                : stat.queueId ?: \"\",\n                zone_id                 : stat.zoneId ?: \"\",\n\n                // Time info\n                end_time                : endTimeStr,\n                timestamp_ms            : timestampMs,\n                event_time              : eventTimeStr,\n\n                // IDs\n                site_id                 : stat.siteId ?: \"\",\n\n                // Metrics\n                count                   : stat.count ?: 0,\n                wait_time               : stat.waitTime ?: 0,\n\n                active_servers          : stat.activeServers ?: 0,\n                active_gates            : stat.activeGates ?: 0,\n\n                avg_server_service_time : stat.avgServerServiceTime ?: 0,\n                avg_gate_service_time   : stat.avgGateServiceTime ?: 0,\n\n                entry_count             : stat.entry ?: 0,\n                exit_count              : stat.exit ?: 0,\n\n                // Audit\n                created_at              : createdAtStr,\n                updated_at              : updatedAtStr\n            ]\n        }\n    }\n\n    // Write output (no pretty print = faster)\n    def outputJson = JsonOutput.toJson(transformed)\n\n    outputStream.write(\n        outputJson.getBytes(StandardCharsets.UTF_8)\n    )\n\n} as StreamCallback)\n\nsession.transfer(flowFile, REL_SUCCESS)"
